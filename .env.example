# Penny and Planet — environment variables
# Copy this file to `.env.local` and fill in only what you're ready to use.
# Everything below "Analytics" onward is optional: the public site works
# fully with none of it set. The admin dashboard section IS required if you
# want to use /admin — see README.md "Admin dashboard setup" for full steps.

# --- Admin dashboard & database (REQUIRED for /admin) ---
# Created automatically when you provision a Postgres database in the
# Vercel dashboard (Storage → Create Database → Postgres) and connect it to
# this project. Pull it locally with `vercel env pull .env.local`, or copy
# it from Vercel → Project → Settings → Environment Variables.
POSTGRES_URL=

# Random signing secret for admin session cookies. Generate one with:
#   openssl rand -base64 32
# Keep this secret — anyone with it could forge an admin session.
ADMIN_SESSION_SECRET=

# Used ONLY by `npm run db:seed-admin` (see scripts/seed-admin.ts) to
# create or reset the admin account. Never read by the running application
# itself — safe to remove from your environment after running that script.
# To reset a forgotten password later: change ADMIN_PASSWORD here and
# re-run `npm run db:seed-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Analytics & verification (see lib/config/env.ts, components/analytics/AnalyticsScripts.tsx) ---
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console HTML-tag verification code (the content= value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to "true" once @vercel/analytics is installed and wired up (see AnalyticsScripts.tsx)
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# --- Newsletter (see lib/services/newsletter.ts) ---
# MailerLite API key + group id — required to move off the in-memory stub
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Contact form (see lib/services/contact.ts) ---
# Destination address / email API key once a real provider is wired up
CONTACT_FORM_RECIPIENT=
EMAIL_API_KEY=

# --- Admin image search & upload (see lib/media/providers/, /admin editor) ---
# Every one of these is optional and independent — the image picker's
# Search tab only offers whichever providers have a key set; Library,
# Upload, and pasting a URL directly all work regardless.

# Unsplash: create a free app at https://unsplash.com/oauth/applications,
# use its "Access Key"
UNSPLASH_ACCESS_KEY=

# Pexels: get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay: get a free API key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Vercel Blob: required only for the "Upload from device" tab (manual photo
# upload). Create a Blob store in the Vercel dashboard (Storage → Create
# Database → Blob) and connect it to this project — this env var is then
# set automatically, the same way POSTGRES_URL is. Without it, uploads show
# a clear message and the Search/Library/paste-a-URL options still work.
BLOB_READ_WRITE_TOKEN=
